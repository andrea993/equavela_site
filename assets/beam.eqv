format: equavela-worksheet/3
page:
  size: A4
  margins: {top: 72, right: 54, bottom: 72, left: 54}
settings:
  format.precision: 3
regions:
  - id: t1
    page: 1
    at: [54, 72]
    text: "BEAM DESIGN | Uniformly distributed load"
  - id: t2
    page: 1
    at: [54, 104]
    text: "A simply supported beam carries a uniform load. We calculate the peak bending moment and check the elastic bending stress against an allowable value."
  - id: t3
    page: 1
    at: [54, 158]
    text: "Inputs — span, line load and section modulus"
  - id: m1
    page: 1
    at: [54, 190]
    math: "L := 3.5 m@unit"
  - id: m2
    page: 1
    at: [200, 190]
    math: "q := 12 kN@unit/m@unit"
  - id: m3
    page: 1
    at: [390, 190]
    math: "W := 150 cm@unit^3"
  - id: t4
    page: 1
    at: [54, 236]
    text: "Peak bending moment and stress"
  - id: m4
    page: 1
    at: [54, 265]
    math: "M_max := q·L^2/8"
  - id: m5
    page: 1
    at: [250, 265]
    math: "M_max = … kN·m"
  - id: m6
    page: 1
    at: [54, 305]
    math: "σ_max := M_max/W"
  - id: m7
    page: 1
    at: [250, 305]
    math: "σ_max = … MPa"
  - id: t5
    page: 1
    at: [54, 357]
    text: "Moment along the span"
  - id: px
    page: 1
    at: [54, 385]
    math: "x := 0, 0.1..3.5"
  - id: pm
    page: 1
    at: [54, 416]
    math: "M(x) := 12·x·(3.5 − x)/2"
  - id: plot
    page: 1
    at: [54, 455]
    plot:
      version: 1
      type: xy
      size: [220, 120]
      axes:
        x: {title: "Position (m)"}
        y: {title: "Moment (kN·m)"}
      traces:
        - {id: moment, x: "x", y: "M(x)"}
  - id: t6
    page: 1
    at: [305, 357]
    text: "Stress utilisation"
  - id: m8
    page: 1
    at: [305, 385]
    math: "σ_allow := 160 MPa@unit"
  - id: m9
    page: 1
    at: [305, 415]
    math: "u := σ_max/σ_allow"
  - id: m10
    page: 1
    at: [305, 445]
    math: |
      check(u) := program
        if u ≤ 1
          "Pass"
        else
          "Review"
  - id: m11
    page: 1
    at: [305, 540]
    math: "check(u) ="
  - id: t7
    page: 1
    at: [54, 605]
    text: "The bending check passes when utilisation is at most 1. Deflection, shear and stability require separate checks."
