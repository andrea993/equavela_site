format: equavela-worksheet/3
page:
  size: A4
  margins: {top: 72, right: 54, bottom: 72, left: 54}
settings:
  format.precision: 3
regions:
  - id: t1
    page: 1
    at: [54, 72]
    text: "BEAM DESIGN | Uniformly distributed load"
  - id: t2
    page: 1
    at: [54, 108]
    text: "A simply supported beam carries a uniform load across its full span. This worksheet estimates the maximum bending moment and checks the resulting elastic bending stress."
  - id: t3
    page: 1
    at: [54, 160]
    text: "1. Inputs — span, line load and elastic section modulus"
  - id: m1
    page: 1
    at: [54, 195]
    math: "L := 3.5 m@unit"
  - id: m2
    page: 1
    at: [205, 195]
    math: "q := 12 kN@unit/m@unit"
  - id: m3
    page: 1
    at: [395, 195]
    math: "W := 150 cm@unit^3"
  - id: t4
    page: 1
    at: [54, 250]
    text: "2. Maximum moment — for a simply supported beam under a uniform load, the peak occurs at midspan."
  - id: m4
    page: 1
    at: [54, 305]
    math: "M_max := q·L^2/8"
  - id: m5
    page: 1
    at: [265, 305]
    math: "M_max = … kN·m"
  - id: t5
    page: 1
    at: [54, 360]
    text: "3. Elastic bending stress — divide the maximum moment by the section modulus."
  - id: m6
    page: 1
    at: [54, 412]
    math: "σ_max := M_max/W"
  - id: m7
    page: 1
    at: [265, 412]
    math: "σ_max = … MPa"
  - id: t6
    page: 1
    at: [54, 470]
    text: "4. Interpretation — compare the calculated stress with an allowable value of 160 MPa."
  - id: m8
    page: 1
    at: [54, 523]
    math: "σ_allow := 160 MPa@unit"
  - id: m9
    page: 1
    at: [265, 523]
    math: "σ_max/σ_allow ="
  - id: t7
    page: 1
    at: [54, 580]
    text: "The ratio is below 1.0, so the assumed section satisfies this illustrative bending-stress check. Deflection, shear and stability require separate checks."
